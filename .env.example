# Copy these keys to your ignored .env file and replace the placeholders.
# Without EMAIL_HOST, Django writes outgoing messages to the development console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-provider-app-password
DEFAULT_FROM_EMAIL="MyShop Orders <your-address@gmail.com>"
EMAIL_TIMEOUT=10